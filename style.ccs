body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  background: #eef2f7;
}

header, footer {
  background: #003366;
  color: white;
  padding: 1rem;
  text-align: center;
}

main {
  margin: 2rem auto;
  max-width: 1100px;
  padding: 0 1rem;
}

.aircraft-list {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fill,minmax(250px,1fr));
}

.aircraft-card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.15);
  overflow: hidden;
  text-align: center;
  padding: 1rem;
}

.aircraft-card img {
  width: 100%;
  height: auto;
  border-bottom: 2px solid #003366;
}

.aircraft-card h3 {
  margin: 0.8rem 0;
  color: #003366;
}

.aircraft-card a {
  text-decoration: none;
  color: #003366;
  font-weight: bold;
}

.aircraft‑details img {
  max-width: 100%;
  border-radius: 8px;
  margin-bottom: 1rem;
}

.aircraft‑details p {
  margin: 0.4rem 0;
}
